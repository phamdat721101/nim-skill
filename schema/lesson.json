{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/phamdat721101/nim-skill/schema/lesson.json",
  "title": "Lesson",
  "type": "object",
  "required": ["id", "capturedAt", "triggerShape", "whatWentWrong", "correctPattern", "severity", "source"],
  "properties": {
    "id": { "type": "string" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "triggerShape": {
      "type": "object",
      "required": ["toolName", "pathGlob", "contentSignal"],
      "properties": {
        "toolName": { "type": "string" },
        "pathGlob": { "type": "string" },
        "contentSignal": { "type": ["string", "null"] },
        "actionKey": { "type": "string" }
      },
      "additionalProperties": false
    },
    "whatWentWrong": { "type": "string" },
    "correctPattern": { "type": "string" },
    "severity": { "enum": ["info", "warning", "critical"] },
    "source": { "enum": ["manual", "auto"] },
    "outcome": { "enum": ["blocked", "wasted_spend", "success"] },
    "costIncurredUsd": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": false
}
